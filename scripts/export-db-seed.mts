// node scripts/export-db-seed.mts > db/seed.sql
// Builds the DB seed from the same loaders the app uses, so DB and app catalog cannot drift.
import {readFileSync} from 'node:fs'
import {parseCsv, toProducts} from '../lib/plan.ts'
import {FIXTURES} from '../lib/fixtures.ts'
import {EXACT_LISTINGS} from '../lib/listings.ts'
import {mergeReal, toRealProducts} from '../lib/real-catalog.ts'
import {ROOM_TYPE_IDS, STYLE_IDS, isStyleId} from '../lib/styles.ts'
import {t} from '../lib/copy.ts'

const CHECKED_ON = '2026-11-21'
const csv = (f: string) => parseCsv(readFileSync(new URL(`../catalog/${f}`, import.meta.url), 'utf8'))

const q = (v: unknown): string => {
  if (v === null || v === undefined || v === '') return 'null'
  if (typeof v === 'number' || typeof v === 'boolean') return String(v)
  if (Array.isArray(v)) return `array[${v.map(q).join(', ')}]::text[]`
  return `'${String(v).replace(/'/g, "''")}'`
}
const rows = (table: string, cols: string[], data: unknown[][]) =>
  data.length ? `insert into ${table} (${cols.join(', ')}) values\n${data.map(r => `  (${r.map(q).join(', ')})`).join(',\n')};\n` : ''

const label = t as unknown as Record<string, string>
const items = [...toProducts(csv('products.csv')), ...FIXTURES]
const ids = new Set<string>()
for (const p of items) { if (ids.has(p.id)) throw new Error('duplicate catalog id ' + p.id); ids.add(p.id) }

const real = mergeReal(toRealProducts(csv('shopee-real-snapshot.csv'), 'alias'), toRealProducts(csv('shopee-real-additions.csv'), 'direct'))
const sourceOf = new Map([
  ...toRealProducts(csv('shopee-real-additions.csv'), 'direct').map(p => [p.id, 'addition'] as const),
  ...toRealProducts(csv('shopee-real-snapshot.csv'), 'alias').map(p => [p.id, 'snapshot'] as const),
])
// raw evidence_status per shop/item (first file wins, same order as mergeReal)
const evidence = new Map<string, string>()
for (const r of [...csv('shopee-real-snapshot.csv'), ...csv('shopee-real-additions.csv')]) {
  const k = `shopee-${r.shop_id?.trim()}-${r.item_id?.trim()}`
  if (!evidence.has(k)) evidence.set(k, r.evidence_status.trim())
}
const shopItem = (url: string) => { const m = url.match(/\/product\/(\d+)\/(\d+)$/); if (!m) throw new Error('bad listing url ' + url); return [m[1], m[2]] as const }

// exact matches: add as listings, or mark rooms on the existing row
const exactRooms = new Map<string, string[]>()
const exactRows: unknown[][] = []
for (const l of EXACT_LISTINGS) {
  const [shop, item] = shopItem(l.url)
  const id = `shopee-${shop}-${item}`
  exactRooms.set(id, l.rooms)
  if (!real.some(p => p.id === id)) exactRows.push([id, shop, item, l.title, 'light', 'photo', `image matched to listing ${l.matchedAt}`, null, 'Exact match used in the demo. Price, size, variant and stock unverified.', 'exact_match', l.rooms, l.matchedAt])
}

const out = [
  `-- Generated by scripts/export-db-seed.mts on ${CHECKED_ON}. Do not edit by hand; rerun the script.`,
  `-- Source: catalog/*.csv, lib/fixtures.ts, lib/listings.ts. No live price/stock data.`,
  `set client_encoding = 'UTF8';`,
  'begin;',
  rows('styles', ['id', 'name_th', 'sort_order'], STYLE_IDS.map((s, i) => [s, label[s] ?? s, i + 1])),
  rows('room_types', ['id', 'name_th', 'sort_order'], ROOM_TYPE_IDS.map((r, i) => [r, label[r] ?? r, i + 1])),
  rows('catalog_items', ['id', 'room_type', 'slot', 'name', 'keyword', 'price_min_thb', 'price_max_thb', 'priority', 'listing_url', 'width_cm', 'uses_floor', 'is_fixture'],
    items.map(p => [p.id, p.roomType, p.slot, p.name, p.keyword, p.priceMin, p.priceMax, p.priority, p.deeplink || null, p.widthCm, p.floor, p.id.startsWith('fixture-')])),
  rows('catalog_item_styles', ['item_id', 'style_id'], items.flatMap(p => p.styles.filter(isStyleId).map(s => [p.id, s]))),
  rows('shopee_listings', ['id', 'shop_id', 'item_id', 'title', 'category', 'verification', 'evidence_status', 'dimensions_cm', 'notes', 'source', 'shown_in_rooms', 'checked_on'], [
    ...real.map(p => { const [shop, item] = shopItem(p.url); return [p.id, shop, item, p.title, p.category, p.verification, evidence.get(p.id), p.dimensions, p.notes, sourceOf.get(p.id), exactRooms.get(p.id) ?? [], CHECKED_ON] }),
    ...exactRows,
  ]),
  rows('shopee_listing_styles', ['listing_id', 'style_id'], real.flatMap(p => p.styles.map(s => [p.id, s]))),
  'commit;',
].join('\n')
process.stdout.write(out + '\n')
