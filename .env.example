# RoomLatch env template. Copy to .env.local and fill in. Never commit real values.
# Neon values: `neon env pull` (or `neon deploy`) writes them into .env.local for you.

# ---------------------------------------------------------------------------
# 1) Neon Postgres — local AND Vercel
# ---------------------------------------------------------------------------
# Pooled URL (host has -pooler). Used by the app (lib/db.ts).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct URL (no -pooler). Only for schema/seed/scripts: psql "$DATABASE_URL_UNPOOLED" -f db/schema.sql
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# 2) Neon Object Storage, S3-compatible (bucket "assets") — local AND Vercel
#    Read automatically by the AWS SDK (lib/storage.ts).
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL_S3=https://replace-with-branch-storage-endpoint
AWS_REGION=ap-southeast-1

# ---------------------------------------------------------------------------
# 3) AI render — OpenAI API for local and deployed servers.
#    A nonempty server-side OPENAI_API_KEY enables rendering. No Codex CLI required.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Check the id against GET /v1/models before changing it: OpenAI retires image models within about a year.
# Models: unset = the defaults in lib/openai-render.ts (MODEL_DEFAULTS), shown here. Check ids against GET /v1/models
# before changing them: OpenAI retires image models within about a year.
# Local/preview final room image (lower cost):
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=low
# Vercel production defaults (VERCEL_ENV=production): highest quality; higher cost and latency.
# Explicit environment variables override these defaults; update old Production overrides too.
# OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# OPENAI_IMAGE_QUALITY=max
# Product cutout, once per Shopee listing then cached in the bucket (~$0.05 each): accuracy over cost
# OPENAI_CUTOUT_MODEL=gpt-image-2.6-sunburst
# OPENAI_CUTOUT_QUALITY=medium
# Reads product sizes and decides placement (JSON answers)
# OPENAI_VISION_MODEL=gpt-6.1-terra
# Picks catalog products for the room within the budget (~$0.01 per call). Without OPENAI_API_KEY a rules pick is used.
# OPENAI_DECISION_MODEL=gpt-6.1-terra
# Renders allowed per 24 hours (openai only). Defaults shown; 0 = nobody may render.
# ROOMLATCH_RENDER_DAILY_LIMIT=5     # per visitor (by IP)
# ROOMLATCH_RENDER_DAILY_CAP=100     # whole deployment: the spending ceiling
# AI product picks (/api/recommend) per 24 hours; over a limit the free rules pick is used. Needs migration 005.
# ROOMLATCH_RECOMMEND_DAILY_LIMIT=20 # per visitor (by IP)
# ROOMLATCH_RECOMMEND_DAILY_CAP=500  # whole deployment

# ---------------------------------------------------------------------------
# 3b) Sign-in (Better Auth, lib/auth.ts) — local AND Vercel, server only
# ---------------------------------------------------------------------------
# Random 32+ bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
# Public origin of the app (Vercel: https://your-domain). Locally leave it unset: a value whose port differs
# from the dev server's makes every sign-in fail with 403 "Invalid origin".
# BETTER_AUTH_URL=https://your-domain
# Comma-separated admin emails for /admin. Must be verified: node --env-file=.env.local scripts/make-admin.mts <email>.
ROOMLATCH_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# 4) LOCAL DEMO ONLY — do NOT set on Vercel
# ---------------------------------------------------------------------------
# 1 = show Shopee seller listing photos from public/listings/ (git-ignored, no publish rights)
NEXT_PUBLIC_SHOW_LISTING_PHOTOS=0

# ---------------------------------------------------------------------------
# 5) Written by the Neon CLI, informational. The app does not read them.
# ---------------------------------------------------------------------------
NEON_BRANCH=production
NEON_BRANCH_ID=br-xxxx
NEON_FUNCTION_HOST_SUFFIX=replace-me
