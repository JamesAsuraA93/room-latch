# RoomLatch env template. Copy to .env.local and fill in. Never commit real values.
# Neon values: `neon env pull` (or `neon deploy`) writes them into .env.local for you.

# ---------------------------------------------------------------------------
# 1) Neon Postgres — needed locally AND on Vercel
# ---------------------------------------------------------------------------
# Pooled URL (host has -pooler). Used by the app (lib/db.ts).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct URL (no -pooler). Only for schema/seed: psql "$DATABASE_URL_UNPOOLED" -f ../db/schema.sql
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# 2) Neon Object Storage (bucket "assets") — needed locally AND on Vercel
#    Read automatically by the AWS SDK (lib/storage.ts).
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL_S3=https://replace-with-branch-storage-endpoint
AWS_REGION=ap-southeast-1

# ---------------------------------------------------------------------------
# 3) Written by the Neon CLI, informational. The app does not read them.
# ---------------------------------------------------------------------------
NEON_BRANCH=production
NEON_BRANCH_ID=br-xxxx
NEON_FUNCTION_HOST_SUFFIX=replace-me

# ---------------------------------------------------------------------------
# 4) LOCAL DEMO ONLY — do NOT set these on Vercel
# ---------------------------------------------------------------------------
# 1 = show Shopee seller listing photos from public/listings/ (no publish rights)
NEXT_PUBLIC_SHOW_LISTING_PHOTOS=0
# 1 = owner's private Feed example + /real-demo (needs local-demo.json + samples/)
ROOMLATCH_LOCAL_DEMO=0
# Live AI render on the Result page. "codex" runs this Mac's signed-in Codex CLI.
# Fails closed on Vercel anyway.
ROOMLATCH_RENDER_PROVIDER=
ROOMLATCH_CODEX_RENDER=0
# Optional: path to the codex binary (default /opt/homebrew/bin/codex)
# ROOMLATCH_CODEX_BIN=/opt/homebrew/bin/codex

# ---------------------------------------------------------------------------
# 5) OpenAI Images provider — built but OFF. Paid API; leave unset.
#    Needs ROOMLATCH_RENDER_PROVIDER=openai and ROOMLATCH_OPENAI_RENDER=1.
# ---------------------------------------------------------------------------
# ROOMLATCH_OPENAI_RENDER=0
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=
